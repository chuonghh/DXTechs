# Chỉ dùng khi chạy `npm run dev` / `npm run preview` (đọc trong vite.config.ts, không vào bundle).
# API chạy local bằng: dotnet run --project server/server.csproj --launch-profile http
# Muốn ghi đè trên máy riêng: tạo .env.development.local (đã được .gitignore bỏ qua).
API_PROXY_TARGET=http://localhost:5043
