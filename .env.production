# Chỉ dùng cho `npm run build` (mode production) — bản deploy lên https://dxtechs.com.
# API nằm ở subdomain riêng (ADR-011 của repo DxTech_server): khác origin nên server phải bật CORS
# cho https://dxtechs.com, và client gửi request với credentials: 'include'.
# Biến VITE_* được nhúng vào bundle: KHÔNG đặt bí mật ở đây.
VITE_API_BASE_URL=https://api.dxtechs.com/api
