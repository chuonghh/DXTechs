# Biến bắt đầu bằng VITE_ được nhúng thẳng vào bundle gửi cho trình duyệt:
# KHÔNG BAO GIỜ đặt mật khẩu, token hay khóa bí mật ở đây.

# Đường dẫn gốc của API. Mặc định cùng domain với web:
#  - production: Nginx trên VPS chuyển /api/* vào container ASP.NET Core (127.0.0.1:8080)
#  - dev (npm run dev): Vite proxy chuyển /api/* tới API_PROXY_TARGET (xem .env.development)
VITE_API_BASE_URL=/api
